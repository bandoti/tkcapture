package require tcltest 2.5
namespace import ::tcltest::*
loadTestedCommands
package require Tk
package require tkcapture

test package-1.1 {package version} -body {
    package present tkcapture
} -match regexp -result {^\d+\.\d+$}

test package-1.2 {version variable matches the package} -body {
    expr {$::tkcapture::version eq [package present tkcapture]}
} -result 1

test package-1.3 {public commands exist and are exported} -body {
    set missing {}
    foreach cmd {capture save png layout} {
	if {[namespace which -command ::tkcapture::$cmd] eq ""
		|| "::tkcapture::$cmd" ni [namespace eval ::tkcapture {
		    lmap c [namespace export] {
			namespace which -command $c
		    }
		}]} {
	    lappend missing $cmd
	}
    }
    set missing
} -result {}

test package-1.3.1 {build configuration} -body {
    list [::tkcapture::pkgconfig list] \
	[expr {[::tkcapture::pkgconfig get xcomposite] in {0 1}}] \
	[expr {[tk windowingsystem] eq "x11"
		|| ![::tkcapture::pkgconfig get xcomposite]}]
} -result {xcomposite 1 1}

test package-1.4 {the tk ensemble is left alone} -body {
    dict exists [namespace ensemble configure tk -map] capture
} -result 0

cleanupTests
return
